---
/**
 * BaseLayout — the HTML shell shared by every page.
 *
 * Centralizes the document head: charset/viewport, fonts, favicon, the full SEO
 * layer (localized title/description, canonical, `hreflang` alternates, Open
 * Graph + Twitter cards) and the GA analytics bootstrap. Pages only compose
 * content and pass their locale/path/meta in.
 *
 * Fonts: Hanken Grotesk (one family for display and body) is preconnected and loaded once
 * here — preconnect shaves the font round-trip (better LCP); a single <link>
 * avoids the render-blocking @import pattern.
 *
 * Analytics: the gtag loader + bootstrap are emitted ONLY when `PUBLIC_GA_ID`
 * is set, so id-less builds ship zero analytics JS and never hit the network.
 *
 * @prop title - Document <title> (localized; falls back to the brand name).
 * @prop description - Meta description for the page (localized).
 * @prop lang - Document language ("es" default | "en"); drives <html lang>.
 * @prop path - This page's root-relative path ("/" | "/en/") for canonical + alternates.
 * @prop ogAlt - Alt text for the social share image (localized).
 */
import { brand, analyticsId } from '../config/site.config';
import { PRIMARY_ORIGIN } from '../config/domain.mjs';
import { LOCALES, DEFAULT_LOCALE, pathForLocale, withBase } from '../lib/i18n';
import { gaBootstrapScript } from '../lib/analytics';
import { jsonLdString, professionalServiceJsonLd, webSiteJsonLd } from '../lib/jsonld';
import type { Locale } from '../content/types';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  lang?: Locale;
  path?: string;
  ogAlt?: string;
  /**
   * Fase 12 · Los caminos ES/EN de ESTA página, para el `hreflang`. Sin ellos, los alternates
   * apuntan a las portadas — correcto para la landing y mentiroso para cualquier página nueva:
   * una página de servicio que declare a la portada como su alternate le enseña a Google que su
   * traducción es otra cosa.
   */
  altPaths?: { es: string; en: string };
  /** Fase 12 · C3: la página de gracias se alcanza pero no se indexa — es una meta, no contenido. */
  noindex?: boolean;
}

const {
  title = 'Nexora · Estudio de Software',
  description = 'Desarrollo de páginas web, sistemas y aplicaciones.',
  lang = 'es',
  path = '/',
  ogAlt = 'Nexora — Estudio de software',
  altPaths,
  noindex = false,
} = Astro.props;

const site = Astro.site ?? new URL(PRIMARY_ORIGIN);
const canonical = new URL(withBase(path), site).href;
const ogImageFile = lang === 'en' ? '/og/og-share-en.png' : '/og/og-share.png';
const ogImage = new URL(withBase(ogImageFile), site).href;

/** hreflang alternates: los de ESTA página si vinieron, o las portadas (el caso original). */
const alternates = LOCALES.map((locale) => ({
  hreflang: locale,
  href: altPaths
    ? new URL(withBase(altPaths[locale]), site).href
    : new URL(pathForLocale(locale), site).href,
}));
const xDefaultHref = altPaths
  ? new URL(withBase(altPaths[DEFAULT_LOCALE]), site).href
  : new URL(pathForLocale(DEFAULT_LOCALE), site).href;

/**
 * A2 · La ficha del estudio y el sitio como entidad, en TODAS las páginas: era el único
 * indicador de "sitio armado a la ligera" que la auditoría encontró disparado (cero JSON-LD).
 */
const baseJsonLd = jsonLdString([professionalServiceJsonLd(), webSiteJsonLd()]);

/** OG locale codes: ES targets Ecuador, EN international. */
const ogLocale = lang === 'es' ? 'es_EC' : 'en_US';
const ogLocaleAlt = lang === 'es' ? 'en_US' : 'es_EC';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    {/* B2 · Safari, iOS y varios rastreadores no leen SVG: sin estos dos mostraban el globo gris. */}
    <link rel="icon" type="image/x-icon" sizes="16x16 32x32 48x48" href={withBase('/favicon.ico')} />
    <link rel="apple-touch-icon" sizes="180x180" href={withBase('/apple-touch-icon.png')} />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    {alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
    <link rel="alternate" hreflang="x-default" href={xDefaultHref} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={brand.legalName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700&display=swap"
        rel="stylesheet"
      />
    </noscript>

    {
      analyticsId && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${analyticsId}`} />
          <script is:inline set:html={gaBootstrapScript(analyticsId)} />
        </>
      )
    }

    <script is:inline type="application/ld+json" set:html={baseJsonLd} />

    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
