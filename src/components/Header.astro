---
/**
 * Header — sticky top chrome shared by both locale pages.
 *
 * What: brand lockup, in-page navigation from `nav[]`, the ES|EN locale switch
 * and the primary CTA, which jumps to the contact section (where WhatsApp and
 * email are both offered). Below `lg` the nav collapses into a native <details>
 * disclosure — keyboard-accessible and zero-JS.
 *
 * @prop content - the active locale's content tree (nav, ui, hero).
 * @prop locale - active locale, drives the ES|EN active state.
 */
import type { Locale, SiteContent } from '../content/types';
import { pathForLocale, STORAGE_KEY } from '../lib/i18n';
import logoRaw from '../assets/logo/nexora-logo-mono.svg?raw';
import Button from './ui/Button.astro';
import Icon from './ui/Icon.astro';
import LanguageToggle from './LanguageToggle.tsx';

interface Props {
  content: SiteContent;
  locale: Locale;
}

const { content, locale } = Astro.props;
const { nav, ui, hero } = content;

const logo = logoRaw
  .replace(/\s(width|height)="[^"]*"/g, '')
  .replace(/\scolor="[^"]*"/g, '');
---

<header class="sticky top-0 z-50 border-b border-border bg-surface/95 backdrop-blur">
  <a
    href="#contenido"
    class="sr-only rounded-lg bg-blue-700 px-4 py-2 font-semibold text-white focus:not-sr-only focus:absolute focus:left-4 focus:top-3 focus:z-[60]"
  >
    {ui.skipToContent}
  </a>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-4 py-3 md:px-6">
    <a
      href={pathForLocale(locale)}
      class="flex h-[2.25rem] items-center text-text-primary md:h-[2.5rem] [&>svg>g]:text-blue-700 [&>svg]:h-full [&>svg]:w-auto [&_text]:font-display"
      set:html={logo}
    />

    <div class="flex items-center gap-6 lg:gap-7">
      <nav class="hidden items-center gap-6 lg:flex" aria-label="Principal">
        {
          nav.map((item) => (
            <a
              href={`#${item.anchor}`}
              class="whitespace-nowrap text-small font-medium text-text-muted transition-colors duration-base ease-standard hover:text-text-primary"
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <div class="flex items-center gap-2 md:gap-3">
        <LanguageToggle
          client:idle
          locale={locale}
          esPath={pathForLocale('es')}
          enPath={pathForLocale('en')}
          storageKey={STORAGE_KEY}
          label={ui.switchLanguage}
        />

        <Button href="#contacto" size="sm" class="hidden sm:inline-flex">
          {hero.ctaPrimary}
        </Button>

        <details class="group relative lg:hidden">
          <summary
            class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-lg border border-border-strong text-text-primary marker:hidden [&::-webkit-details-marker]:hidden"
            aria-label={ui.openMenu}
          >
            <Icon name="ui-menu" class="h-6 w-6" />
          </summary>
          <nav
            class="absolute right-0 mt-2 flex w-64 flex-col gap-1 rounded-lg border border-border bg-surface p-2 shadow-lg"
            aria-label="Móvil"
          >
            {
              nav.map((item) => (
                <a
                  href={`#${item.anchor}`}
                  class="flex min-h-[2.75rem] items-center rounded-md px-3 text-body font-medium text-text-primary hover:bg-background"
                >
                  {item.label}
                </a>
              ))
            }
            <a
              href="#contacto"
              class="mt-1 flex min-h-[2.75rem] items-center justify-center rounded-lg bg-blue-700 px-3 text-body font-semibold text-white"
            >
              {hero.ctaPrimary}
            </a>
          </nav>
        </details>
      </div>
    </div>
  </div>
</header>
