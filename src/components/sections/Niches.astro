---
/**
 * Niches / "Sectores" (section 05) — who Nexora works with.
 *
 * What: the section header beside a list of sectors from `niches[]`. The order
 * of the array is editorial (larger scale first), and the list spans companies
 * through independent professionals, which is how the page signals a mixed
 * audience without ever stating it. NO prices.
 *
 * @prop content - active locale content tree.
 */
import type { SiteContent } from '../../content/types';
import SectionEyebrow from '../ui/SectionEyebrow.astro';

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
const { niches, sections } = content;
---

<section id="para-quien" class="bg-surface">
  <div
    class="mx-auto grid max-w-6xl gap-6 px-4 pt-8 md:px-6 lg:grid-cols-[minmax(0,25rem)_minmax(0,1fr)] lg:gap-9 lg:pt-9"
  >
    <SectionEyebrow header={sections.niches} />

    <ul class="flex flex-wrap gap-2 sm:grid sm:grid-cols-2 sm:gap-3">
      {
        niches.map((niche) => (
          <li class="flex min-h-[2.75rem] items-center rounded-lg border border-border px-4 text-small font-medium text-text-primary sm:min-h-[3.5rem] sm:px-5 sm:text-body">
            {niche.label}
          </li>
        ))
      }
    </ul>
  </div>
</section>
