---
/**
 * Hero (section 01) — the above-the-fold statement, on white.
 *
 * What: the studio label, the headline + subheadline, the two CTAs, the
 * proposal card (what is delivered in writing) and the three-pillar strip.
 * Why the card: the headline states what Nexora develops; the card is the proof
 * beside it — each row is something the real proposal contains. The primary CTA
 * funnels to contact; the secondary jumps to the projects — there is NO pricing
 * anywhere. All copy comes from `hero` / `pillars`.
 *
 * The eyebrow reads `hero.eyebrow`, not `footer.tagline`: the city belongs to
 * the footer only, so the two must not share a string.
 *
 * @prop content - active locale content tree.
 */
import type { SiteContent } from '../../content/types';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
const { hero, pillars } = content;
---

<section id="inicio" class="bg-surface">
  <div
    class="mx-auto grid max-w-6xl gap-7 px-4 pb-7 pt-8 md:px-6 lg:grid-cols-[minmax(0,1fr)_27.5rem] lg:items-center lg:gap-8 lg:pt-9"
  >
    <div class="flex flex-col gap-5">
      <p class="self-start rounded-sm bg-blue-50 px-3 py-1 text-small font-semibold text-blue-800">
        {hero.eyebrow}
      </p>

      <h1 class="font-display text-h1 text-text-primary lg:text-display">
        {hero.headline}
      </h1>

      <p class="max-w-xl text-body-lg text-text-muted">
        {hero.subheadline}
      </p>

      <div class="mt-1 flex flex-col gap-3 sm:flex-row">
        <Button href="#contacto">{hero.ctaPrimary}</Button>
        <Button href="#demos" variant="secondary">{hero.ctaSecondary}</Button>
      </div>
    </div>

    <div class="flex flex-col rounded-lg border border-border bg-surface shadow-card">
      <div class="flex flex-col gap-1 border-b border-border px-5 py-4">
        <p class="text-small font-semibold text-blue-800">{hero.proposalEyebrow}</p>
        <p class="font-display text-h3 text-text-primary">{hero.proposalHeading}</p>
      </div>
      <ul class="flex flex-col">
        {
          hero.proposalItems.map((item) => (
            <li class="flex items-start gap-3 border-b border-border px-5 py-3 text-body text-text-primary last:border-b-0">
              <Icon name="ui-check" class="mt-[2px] h-5 w-5 text-blue-700" />
              {item}
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="mx-auto max-w-6xl px-4 pb-8 md:px-6 lg:pb-9">
    <ul class="grid gap-px overflow-hidden rounded-lg border border-border bg-border md:grid-cols-3">
      {
        pillars.map((pillar) => (
          <li class="flex flex-col gap-1 bg-surface px-5 py-5">
            <span class="font-display text-h3 text-text-primary">{pillar.stat}</span>
            <span class="text-small text-text-muted">{pillar.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
