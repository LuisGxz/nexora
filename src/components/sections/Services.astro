---
/**
 * Services (section 02) — what Nexora builds, one card per pain.
 *
 * What: the section header plus a responsive grid of service cards, each an
 * icon chip + title + the outcome it delivers — all from `services[]`. Why
 * benefit-first copy: it states what the client gets, not what they lack, and
 * reads the same for an individual or a company. NO prices.
 *
 * @prop content - active locale content tree.
 */
import type { Locale, SiteContent } from '../../content/types';
import SectionEyebrow from '../ui/SectionEyebrow.astro';
import Icon from '../ui/Icon.astro';
import { withBase } from '../../lib/i18n';

interface Props {
  content: SiteContent;
  /** Fase 12 · A5: decide el prefijo de la página de servicio enlazada desde la tarjeta. */
  locale?: Locale;
}

const { content, locale = 'es' } = Astro.props;
const { services, sections } = content;

/** El href de la página propia de un servicio, en el árbol del idioma activo. */
const serviceHref = (slug: string) =>
  withBase(locale === 'es' ? `/servicios/${slug}/` : `/en/services/${slug}/`);
---

<section id="servicios" class="bg-background">
  <div class="mx-auto flex max-w-6xl flex-col gap-7 px-4 py-9 md:px-6">
    <SectionEyebrow header={sections.services} />

    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        services.map((service) => (
          <li class="flex flex-col gap-3 rounded-xl border border-border bg-surface p-5 shadow-sm transition-shadow duration-base ease-standard hover:shadow-md">
            <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-blue-50 text-blue">
              <Icon name={service.icon} class="h-6 w-6" />
            </span>
            <h3 class="font-display text-h4 text-text-primary">{service.title}</h3>
            <p class="text-small text-text-muted">{service.benefit}</p>
            {/* A5 · La tarjeta enlaza su página propia cuando existe: el camino interno que le
                dice a Google (y al visitante) que hay más que una tarjeta. */}
            {service.pageSlug && (
              <a
                href={serviceHref(service.pageSlug)}
                class="mt-auto inline-flex items-center gap-1 text-small font-semibold text-blue transition-colors duration-base ease-standard hover:text-blue-700"
              >
                {content.ui.viewService}
                <Icon name="ui-arrow" class="h-4 w-4" />
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>
