---
/**
 * Works / Projects (section 03) — ONLY Nexora's own work.
 *
 * What: the section header, a grid of project cards (preview, type tag, title,
 * result, and a link when a live URL exists) and a closing band that offers the
 * two contact channels, WhatsApp and email. Preview: a real screenshot when
 * `work.image` is set (lazy, fixed aspect so CLS stays 0); otherwise a neutral
 * token-colored panel — never a fake illustration. Past employers never appear
 * here (they live in About as background).
 *
 * The link renders only when the URL is real (not a `#` placeholder), so there
 * are no dead links.
 *
 * @prop content - active locale content tree.
 */
import type { SiteContent } from '../../content/types';
import { brand, whatsappNumber } from '../../config/site.config';
import { waLink } from '../../lib/whatsapp';
import SectionEyebrow from '../ui/SectionEyebrow.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
const { works, sections, ui, contact } = content;

/** A demo link is live only when a real URL is set (placeholders are `#`). */
const isLive = (url?: string): url is string => !!url && url !== '#';

const whatsappHref = waLink(whatsappNumber, contact.whatsappPrefill);
---

<section id="demos" class="bg-surface">
  <div class="mx-auto flex max-w-6xl flex-col gap-7 px-4 py-8 md:px-6 lg:py-9">
    <SectionEyebrow header={sections.works} />

    <ul class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {
        works.map((work) => (
          <li class="flex flex-col overflow-hidden rounded-lg border border-border bg-surface">
            <div class="relative aspect-video border-b border-border bg-blue-50">
              {work.image && (
                <img
                  src={work.image}
                  alt={work.title}
                  width="960"
                  height="540"
                  loading="lazy"
                  decoding="async"
                  class="absolute inset-0 h-full w-full object-cover object-top"
                />
              )}
            </div>
            <div class="flex flex-1 flex-col gap-2 p-5">
              <p class="flex flex-wrap items-center gap-2 text-small font-semibold text-blue-800">
                {work.clientType}
                {work.badge && (
                  <span class="rounded-sm bg-success-soft px-2 py-[2px] text-caption text-success-ink">
                    {work.badge}
                  </span>
                )}
              </p>
              <h3 class="font-display text-h4 text-text-primary">{work.title}</h3>
              <p class="flex-1 text-small text-text-muted">{work.result}</p>
              {isLive(work.url) && (
                <a
                  href={work.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex min-h-[2.75rem] items-center gap-1 self-start text-small font-semibold text-blue-700 transition-colors duration-base ease-standard hover:text-blue-800"
                >
                  {work.linkLabel ?? ui.viewDemo}
                  <Icon name="ui-arrow" class="h-4 w-4" />
                </a>
              )}
            </div>
          </li>
        ))
      }
    </ul>

    <div
      class="flex flex-col gap-4 rounded-lg border border-border bg-background p-5 md:flex-row md:items-center md:justify-between"
    >
      <div class="flex flex-col gap-1">
        <p class="font-display text-h3 text-text-primary">{contact.channelsHeading}</p>
        <p class="text-small text-text-muted">{contact.channelsBody}</p>
      </div>
      <div class="grid grid-cols-2 gap-3 md:flex">
        <Button
          href={whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          data-analytics-cta="whatsapp"
          data-analytics-source="works"
        >
          {contact.whatsappCtaLabel}
        </Button>
        <Button href={`mailto:${brand.email}`} variant="secondary">
          {contact.emailCtaLabel}
        </Button>
      </div>
    </div>
  </div>
</section>
