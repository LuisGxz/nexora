---
/**
 * Contact (section 09) — the conversion close, on the one dark band.
 *
 * What: the headline + lead, the two channels (WhatsApp and email), the vCard
 * download and the quote-form island. Why two channels plus a form: a one-tap
 * prefilled WhatsApp chat, an email address for those who prefer it, and the
 * form for those who want to describe the requirement first — the form lands in
 * WhatsApp, no server.
 *
 * No location here by editorial rule: the city appears only in the footer.
 *
 * Number/email/paths come from `site.config.ts` (single source); the raw number
 * is never rendered as scrapable text — only inside the `wa.me` href.
 *
 * @prop content - active locale content tree.
 */
import type { SiteContent } from '../../content/types';
import { brand, whatsappNumber, vcardPath } from '../../config/site.config';
import { waLink } from '../../lib/whatsapp';
import QuoteForm from '../QuoteForm.tsx';
import Button from '../ui/Button.astro';

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
const { contact } = content;

const whatsappHref = waLink(whatsappNumber, contact.whatsappPrefill);
---

<section id="contacto" class="bg-navy-900 text-text-on-dark">
  <div class="mx-auto grid max-w-6xl gap-7 px-4 py-8 md:px-6 lg:grid-cols-2 lg:gap-9 lg:py-9">
    <div class="flex flex-col gap-5">
      <h2 class="font-display text-h1 text-text-on-dark lg:text-display">{contact.heading}</h2>
      <p class="max-w-prose text-body-lg text-text-muted-dark">{contact.subheading}</p>

      <div class="flex flex-col gap-3 sm:flex-row">
        <Button
          href={whatsappHref}
          variant="inverse"
          icon="ui-whatsapp"
          target="_blank"
          rel="noopener noreferrer"
          data-analytics-cta="whatsapp"
          data-analytics-source="contact"
        >
          {contact.whatsappCtaLabel}
        </Button>
        <Button href={`mailto:${brand.email}`} variant="outline-dark" class="break-all">
          {brand.email}
        </Button>
      </div>

      <a
        href={vcardPath}
        download
        class="inline-flex min-h-[2.75rem] items-center self-start text-small font-semibold text-text-muted-dark underline-offset-4 transition-colors duration-base ease-standard hover:text-text-on-dark hover:underline"
      >
        {contact.vcardLabel}
      </a>
    </div>

    <div class="rounded-lg bg-surface p-5 text-text-primary md:p-6">
      <QuoteForm
        client:visible
        labels={contact.form}
        template={contact.prefillTemplate}
        number={whatsappNumber}
      />
    </div>
  </div>
</section>
