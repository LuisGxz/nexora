---
/**
 * Process (section 04) — how Nexora works, as one compact band.
 *
 * What: the section header beside the ordered steps from `process[]`, each a
 * step number + title + one line, laid out as four columns on desktop and
 * stacked on mobile. Why compact: the owner asked for a concise block instead
 * of a tall timeline. The display index comes from the data (`step`), so
 * re-ordering content re-numbers the band automatically.
 *
 * @prop content - active locale content tree.
 */
import type { SiteContent } from '../../content/types';
import SectionEyebrow from '../ui/SectionEyebrow.astro';

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
const { process, sections } = content;
---

<section id="proceso" class="bg-background">
  <div
    class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-8 md:px-6 lg:flex-row lg:items-center lg:gap-8"
  >
    <div class="lg:w-[15rem] lg:shrink-0">
      <SectionEyebrow header={sections.process} compact />
    </div>

    <ol
      class="grid flex-1 gap-px overflow-hidden rounded-lg border border-border bg-border sm:grid-cols-2 lg:grid-cols-4"
    >
      {
        process.map((stepItem) => (
          <li class="flex flex-col gap-1 bg-surface px-5 py-4">
            <span class="text-small font-bold text-blue-800">{stepItem.step}</span>
            <h3 class="font-display text-h4 text-text-primary">{stepItem.title}</h3>
            <p class="text-small text-text-muted">{stepItem.description}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
