---
/**
 * El cuerpo de una página de servicio (fase 12 · A5 + C4), compartido por los dos idiomas.
 *
 * Estructura fija a propósito — hero → qué incluye → el caso → proceso → FAQ → CTA — para que
 * las cuatro páginas se lean como hermanas y agregar la quinta sea llenar contenido, no
 * diseñar. El caso (C4) es la pieza que convierte el demo en argumento: problema → decisión →
 * resultado, con el demo enlazado AL FINAL — primero la historia, después la prueba.
 *
 * El CTA lleva `data-analytics-cta` para que el listener delegado del layout registre el
 * `cta_whatsapp` con su `source` propio, igual que el resto de los botones del sitio.
 *
 * @prop page - El contenido de la página, en su idioma.
 * @prop content - El árbol del idioma (proceso y microcopy compartidos).
 * @prop waHref - El deep-link de WhatsApp con el prefill del servicio.
 */
import type { ServicePage, SiteContent } from '../../content/types';
import Icon from '../ui/Icon.astro';

interface Props {
  page: ServicePage;
  content: SiteContent;
  waHref: string;
}

const { page, content, waHref } = Astro.props;
---

<section class="bg-navy-900 text-text-on-dark">
  <div class="mx-auto flex max-w-4xl flex-col gap-5 px-4 py-9 md:px-6">
    <h1 class="font-display text-h1">{page.heading}</h1>
    <p class="max-w-2xl text-body-lg text-text-muted-dark">{page.intro}</p>
    <a
      href={waHref}
      target="_blank"
      rel="noopener noreferrer"
      data-analytics-cta="whatsapp"
      data-analytics-source={`service_${page.slug}`}
      class="inline-flex w-fit items-center gap-2 min-h-[3.25rem] rounded-lg bg-surface px-5 font-display text-body font-semibold text-navy-900 transition-colors duration-base ease-standard hover:bg-blue-50"
    >
      <Icon name="ui-whatsapp" class="h-5 w-5" />
      {page.ctaLabel}
    </a>
  </div>
</section>

<section class="bg-background">
  <div class="mx-auto flex max-w-4xl flex-col gap-5 px-4 py-8 md:px-6">
    <h2 class="font-display text-h2 text-text-primary">{page.includesHeading}</h2>
    <ul class="flex flex-col gap-3">
      {
        page.includes.map((item) => (
          <li class="flex items-start gap-3 text-body text-text-muted">
            <span class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-blue-50 text-blue">
              <Icon name="ui-check" class="h-3.5 w-3.5" />
            </span>
            {item}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<section class="bg-surface">
  <div class="mx-auto flex max-w-4xl flex-col gap-4 px-4 py-8 md:px-6">
    <h2 class="font-display text-h2 text-text-primary">{page.caseStudy.heading}</h2>
    <div class="flex flex-col gap-4 rounded-lg border border-border bg-background p-5">
      <p class="text-body text-text-muted">{page.caseStudy.problem}</p>
      <p class="text-body text-text-muted">{page.caseStudy.decision}</p>
      <p class="text-body font-medium text-text-primary">{page.caseStudy.result}</p>
      <a
        href={page.caseStudy.demoUrl}
        class="inline-flex w-fit items-center gap-1 text-small font-semibold text-blue transition-colors duration-base ease-standard hover:text-blue-800"
      >
        {page.caseStudy.demoLabel}
        <Icon name="ui-arrow" class="h-4 w-4" />
      </a>
    </div>
  </div>
</section>

<section class="bg-background">
  <div class="mx-auto flex max-w-4xl flex-col gap-5 px-4 py-8 md:px-6">
    <h2 class="font-display text-h2 text-text-primary">{content.sections.process.heading}</h2>
    <ol class="grid gap-4 sm:grid-cols-2">
      {
        content.process.map((step) => (
          <li class="flex flex-col gap-2 rounded-lg border border-border bg-surface p-5">
            <span class="font-mono text-small text-blue">{step.step}</span>
            <h3 class="font-display text-h4 text-text-primary">{step.title}</h3>
            <p class="text-small text-text-muted">{step.description}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<section class="bg-surface">
  <div class="mx-auto flex max-w-4xl flex-col gap-5 px-4 py-8 md:px-6">
    <h2 class="font-display text-h2 text-text-primary">{page.faqHeading}</h2>
    <div class="flex flex-col gap-3">
      {
        page.faq.map((item) => (
          <details class="group rounded-lg border border-border bg-background p-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-3 font-display text-h4 text-text-primary">
              {item.question}
              <span
                aria-hidden="true"
                class="text-blue transition-transform duration-base ease-standard group-open:rotate-90"
              >
                ›
              </span>
            </summary>
            <p class="mt-3 text-body text-text-muted">{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<section class="bg-navy-900 text-text-on-dark">
  <div class="mx-auto flex max-w-4xl flex-col items-start gap-4 px-4 py-9 md:px-6">
    <h2 class="font-display text-h2">{page.ctaHeading}</h2>
    <a
      href={waHref}
      target="_blank"
      rel="noopener noreferrer"
      data-analytics-cta="whatsapp"
      data-analytics-source={`service_${page.slug}_footer`}
      class="inline-flex items-center gap-2 min-h-[3.25rem] rounded-lg bg-surface px-5 font-display text-body font-semibold text-navy-900 transition-colors duration-base ease-standard hover:bg-blue-50"
    >
      <Icon name="ui-whatsapp" class="h-5 w-5" />
      {page.ctaLabel}
    </a>
  </div>
</section>
