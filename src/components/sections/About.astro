---
/**
 * About / "Trayectoria" (section 06) — what backs the studio.
 *
 * What: heading + body and the profile links on one side; on the other, the
 * team's prior employers framed strictly as professional background (NEVER as
 * clients). Why faceless: no photo and no named individual — the body and the
 * track record carry the trust. All copy from `about` + `ui` labels.
 *
 * @prop content - active locale content tree.
 */
import type { SiteContent } from '../../content/types';
import SectionEyebrow from '../ui/SectionEyebrow.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
const { about, sections, ui } = content;

/** Hide a profile link until its real URL is wired in `site.config.ts`. */
const visibleLinks = about.links.filter((link) => link.href && link.href !== '#');
---

<section id="estudio" class="bg-surface">
  <div class="mx-auto grid max-w-6xl gap-7 px-4 py-8 md:px-6 lg:grid-cols-2 lg:gap-9 lg:py-9">
    <div class="flex flex-col gap-5">
      <SectionEyebrow header={sections.about} />
      <p class="max-w-prose text-body-lg text-text-muted">{about.body}</p>

      {
        visibleLinks.length > 0 && (
          <ul class="flex flex-wrap gap-3">
            {visibleLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex min-h-[2.75rem] items-center gap-2 rounded-lg border border-border-strong bg-surface px-4 text-small font-semibold text-text-primary transition-colors duration-base ease-standard hover:border-blue-700 hover:text-blue-700"
                >
                  <Icon name={link.icon} class="h-[1.1rem] w-[1.1rem]" />
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    <div class="flex flex-col self-start rounded-lg border border-border">
      <p class="border-b border-border px-5 py-4 text-small font-semibold text-text-muted">
        {ui.experienceLabel}
      </p>
      <ul class="flex flex-col">
        {
          about.experience.map((job) => (
            <li class="flex flex-col gap-1 border-b border-border px-5 py-4 last:border-b-0 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
              <div class="flex flex-col">
                <span class="font-display text-h4 text-text-primary">{job.company}</span>
                <span class="text-small text-text-muted">{job.role}</span>
              </div>
              <span class="text-small text-text-muted sm:shrink-0 sm:whitespace-nowrap">
                {job.period}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
