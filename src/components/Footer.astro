---
/**
 * Footer — closing chrome on a light band, shared by both locales.
 *
 * What: brand lockup, tagline (the only place the city appears), the
 * local-trust line (RUC / invoicing), the privacy link and the rights notice —
 * all from `footer` + `ui`. Why faceless: the work is the hero, so no people or
 * founder imagery.
 *
 * @prop content - active locale content tree (footer, ui).
 */
import type { Locale, SiteContent } from '../content/types';
import logoRaw from '../assets/logo/nexora-logo-mono.svg?raw';
import { withBase } from '../lib/i18n';

interface Props {
  content: SiteContent;
  /** Fase 12: decide el árbol del enlace de privacidad. Opcional para no romper llamadores viejos. */
  locale?: Locale;
}

const { content, locale = 'es' } = Astro.props;
const { footer, ui } = content;

/** Fase 12 · decisión D: la política enlazada desde el footer, como pide el propio documento. */
const privacyHref = withBase(locale === 'en' ? '/en/privacy/' : '/privacidad/');

const logo = logoRaw
  .replace(/\s(width|height)="[^"]*"/g, '')
  .replace(/\scolor="[^"]*"/g, '');
---

<footer class="border-t border-border bg-surface text-text-muted">
  <div class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-6 text-small md:px-6">
    <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
      <div class="flex flex-col gap-2 md:flex-row md:items-center md:gap-4">
        <span
          class="flex h-7 items-center text-text-primary [&>svg>g]:text-blue-700 [&>svg]:h-full [&>svg]:w-auto [&_text]:font-display"
          set:html={logo}
        />
        <p class="font-semibold text-text-primary">{footer.tagline}</p>
      </div>
      <p>{footer.localSignal}</p>
    </div>

    <div
      class="flex flex-col gap-1 border-t border-border pt-4 md:flex-row md:items-center md:justify-between"
    >
      <p>{footer.rights}</p>
      <a
        href={privacyHref}
        class="flex min-h-[2.75rem] items-center underline-offset-4 transition-colors duration-base ease-standard hover:text-blue-700 hover:underline"
      >
        {ui.privacyLink}
      </a>
    </div>
  </div>
</footer>
